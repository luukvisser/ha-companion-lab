# defaults.env: the lab's default settings. lib.sh reads it AFTER lab.env, and every line keeps a
# value that is already set (`${VAR:-default}`), so the environment and lab.env win. Do not edit
# this file for your own setup: put changes in lab.env (see lab.env.example and docs/settings.md).
# Nothing here is secret: tokens and passwords live in their own files, which no script prints.

# ── Core: emulator + Companion app + DevTools ──────────────────────────────────────────────
# Where the Android SDK pieces are installed (setup/install-sdk.sh).
SDK_DIR="${SDK_DIR:-$HOME/android-sdk}"
# Android API level of the system image (google_apis). 37 is Android 17. The image's ABI follows
# the host (x86_64 on x86_64, arm64-v8a on Apple Silicon); SDK_ABI overrides it.
API_LEVEL="${API_LEVEL:-37}"
AVD_NAME="${AVD_NAME:-ha-companion-lab}"
# Screen of the emulated phone.
AVD_WIDTH="${AVD_WIDTH:-1080}"
AVD_HEIGHT="${AVD_HEIGHT:-2400}"
AVD_DENSITY="${AVD_DENSITY:-420}"
# Companion app release from github.com/home-assistant/android ("minimal": no Google services).
COMPANION_VERSION="${COMPANION_VERSION:-2026.11.1}"
PKG="${PKG:-io.homeassistant.companion.android.minimal}"
# The lab's own Home Assistant (stack/, started by `./lab up`): its data folder (HA config, the
# owner's password, the token, the test user's password; mode 700, files 600) and its ports on
# 127.0.0.1. The emulator reaches it as localhost:<port> (adb reverse, set at every emulator start).
LAB_HA_DATA="${LAB_HA_DATA:-$HOME/ha-companion-lab-data/stack}"
LAB_HA_PORT="${LAB_HA_PORT:-8124}"
LAB_WEBRTC_PORT="${LAB_WEBRTC_PORT:-8557}"
# The Avent add-on in that Home Assistant: on, off, or auto (on when AVENT_INTEGRATION_SRC holds an
# aventproxy checkout).
LAB_AVENT="${LAB_AVENT:-auto}"
# Home Assistant as seen from this machine and from the emulator. By default the lab's own; set
# these (and the two files below) in lab.env to use a Home Assistant of your own instead.
HA_URL="${HA_URL:-http://127.0.0.1:$LAB_HA_PORT}"
HA_URL_EMULATOR="${HA_URL_EMULATOR:-http://localhost:$LAB_HA_PORT}"
# A file holding a long-lived access token of an admin user, for the setup scripts only.
HA_TOKEN_FILE="${HA_TOKEN_FILE:-$LAB_HA_DATA/token}"
# The limited test user the app logs in with (setup/ha-test-user.sh creates it: not an admin,
# local network only) and the file its password is kept in (mode 600, never printed).
TEST_USER_NAME="${TEST_USER_NAME:-Companion lab}"
TEST_USER="${TEST_USER:-companion-lab}"
TEST_USER_PASSWORD_FILE="${TEST_USER_PASSWORD_FILE:-$LAB_HA_DATA/test-user-password}"
# Any page to leave the page under test for.
OTHER_PATH="${OTHER_PATH:-/profile/general}"
# Results (screenshots, logs, recordings, result.json + meta.json per measurement).
OUT_DIR="${OUT_DIR:-$HOME/ha-companion-lab-data/out}"
# What the lab last set up (the test camera's stream, the installed card build), for meta.json and
# `lab reset-state`.
LAB_STATE_DIR="${LAB_STATE_DIR:-$HOME/ha-companion-lab-data/state}"
# Port on this machine for the app WebView's DevTools.
CDP_PORT="${CDP_PORT:-9333}"
# Picture-in-picture for the app: on (Android's default: Home in fullscreen floats the video in a small
# window and the page stays visible) or off (leaving a fullscreen card hides the page, as on a real
# Pixel on 10-11-2026). Applied when the emulator starts and whenever a script starts the app fresh
# (lib.sh app_pip), so `APP_PIP=off lab card ...` measures with it off.
APP_PIP="${APP_PIP:-on}"
# Playwright image; its version must match the playwright-core in PW_NODE_MODULES.
PW_IMAGE="${PW_IMAGE:-mcr.microsoft.com/playwright:v1.62.0-noble@sha256:baed2032d533817f3dbe6425de795788430ba345e819a1201337009ba17c9d07}"
# A node_modules with the Playwright image's playwright-core (`lab playwright-install` puts it here).
PW_NODE_MODULES="${PW_NODE_MODULES:-$HOME/ha-companion-lab-data/playwright/node_modules}"

# ── Video layer (video/): test stream, test camera, test dashboard ──────────────────────────
TEST_PATH="${TEST_PATH:-/test-dashboard/test}"
# The camera for hand-placed overlay cards (an image camera; see README, pitfalls).
OVERLAY_CAMERA="${OVERLAY_CAMERA:-camera.test_pattern}"

# The images every layer runs go2rtc and MediaMTX from: one place, pinned by digest (compose
# files and scripts read these; nothing else names the images).
LAB_GO2RTC_IMAGE="${LAB_GO2RTC_IMAGE:-alexxit/go2rtc:1.9.15@sha256:e098de5c2f8040dc3d4784ed2d5cfdac3b0979f9349afe587ef6a670a14b9f4d}"
LAB_MEDIAMTX_IMAGE="${LAB_MEDIAMTX_IMAGE:-bluenviron/mediamtx:1.21.3-ffmpeg@sha256:208e9f1740a09a5ee63b6308e77ce0d54fce0456462f640e6bd9acfc62ebb5a2}"

# The test stream on this machine: 127.0.0.1:18554 (8554 is the Android emulator's gRPC port).
TESTSTREAM_PORT="${TESTSTREAM_PORT:-18554}"
# Opt-in audio scenes and talk-back (video/audio/): where talk-back recordings and the talk-test
# tone go. The lab go2rtc there has no port on this machine at all (video/audio/README.md).
TALK_STATUS_DIR="${TALK_STATUS_DIR:-$HOME/ha-companion-lab-data/talk}"
LAB_AUDIO_DATA="${LAB_AUDIO_DATA:-$HOME/ha-companion-lab-data/audio}"

# ── Card layer (video/advanced-camera-card/): serving and comparing card builds ─────────────
# Where Home Assistant serves the card's JavaScript (HACS: /hacsfiles/advanced-camera-card/).
CARD_PREFIX="${CARD_PREFIX:-/local/community/advanced-camera-card/}"
# Card builds, one dist/ folder per variant name.
BUILDS_DIR="${BUILDS_DIR:-$HOME/ha-companion-lab-data/builds}"
# Where the card sits on screen for the white/picture rating (ffmpeg crop w:h:x:y).
CARD_CROP="${CARD_CROP:-1000:500:40:250}"

# ── The Avent add-on (stack/compose.avent.yml) ─────────────────────────────────────────────
# Where the integration is copied from: an aventproxy checkout and a git ref, or WORKTREE for its
# files as they are (e.g. a branch under development).
AVENT_INTEGRATION_SRC="${AVENT_INTEGRATION_SRC:-$HOME/aventproxy}"
AVENT_INTEGRATION_REF="${AVENT_INTEGRATION_REF:-origin/main}"
# The simulated bridge's media (a test stream path), and the camera's name: the fake Tuya API
# reports it and the simulator serves it, so the integration's RTSP URL matches.
AVENT_LAB_SIM_SOURCE="${AVENT_LAB_SIM_SOURCE:-rtsp://172.31.240.5:8554/baby}"
AVENT_LAB_CAMERA_NAME="${AVENT_LAB_CAMERA_NAME:-Lab baby monitor}"

# `lab reset-state`: the card build (a name under BUILDS_DIR) and the test camera's stream it
# restores (the test stream inside the lab's Home Assistant network).
LAB_DEFAULT_BUILD="${LAB_DEFAULT_BUILD:-main}"
LAB_DEFAULT_STREAM="${LAB_DEFAULT_STREAM:-rtsp://172.31.240.5:8554/pattern_video}"
